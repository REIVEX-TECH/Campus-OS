# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
# Single connection string used by BOTH migrations and app runtime (see
# CLAUDE.md §4 "single DATABASE_URL"). It points at the least-privilege,
# NOSUPERUSER role `campusos_app` created by scripts/db-bootstrap.sql. Row-Level
# Security is FORCED on every tenant-scoped table, so this role — even as the
# table owner — cannot read across tenants.
DATABASE_URL=postgres://campusos_app:campusos_dev_password@localhost:5432/campusos_dev

# Separate database used only by the integration test suite (it is reset by the
# tests). Same least-privilege role.
TEST_DATABASE_URL=postgres://campusos_app:campusos_dev_password@localhost:5432/campusos_test

# ─── Web / tenancy ───────────────────────────────────────────────────────────
# Three host vars work together. In production PLATFORM_HOST and
# TENANT_BASE_DOMAIN are the SAME value (campusos.reivex.io): tenants nest UNDER
# the platform root as subdomains of it. APP_DOMAIN is the LEGACY flat root kept
# only for a removable redirect. The /u/{slug} path prefix is the local-dev
# fallback. See docs/DEPLOY.md (Vercel/Neon) or docs/DEPLOY-VPS.md (self-hosted).

# TENANT_BASE_DOMAIN — the base domain tenant subdomains nest under: a tenant is
# {slug}.TENANT_BASE_DOMAIN. In production set it to campusos.reivex.io so
# lgu.campusos.reivex.io resolves to the `lgu` tenant. Until it is set,
# resolution falls back to APP_DOMAIN, so the app is unchanged (the migration is
# inert until you configure this).
TENANT_BASE_DOMAIN=localhost:3000

# PLATFORM_HOST — the platform landing host that is NOT a tenant (it lists the
# universities). In production this equals TENANT_BASE_DOMAIN (campusos.reivex.io):
# the bare base serves the landing, its subdomains are tenants. Leave empty in
# local dev (the bare localhost host already serves the landing).
PLATFORM_HOST=

# APP_DOMAIN — LEGACY root domain (e.g. reivex.io). Kept ONLY so requests on the
# old flat form {slug}.APP_DOMAIN (lgu.reivex.io) 308-redirect to the nested form
# {slug}.TENANT_BASE_DOMAIN. Removable: unset it (or set it equal to
# TENANT_BASE_DOMAIN) to drop the legacy redirect. If TENANT_BASE_DOMAIN is unset
# this is still the active tenant-resolution root (the pre-migration behaviour).
APP_DOMAIN=localhost:3000

# Port the Next.js server listens on. Dev defaults to 3000; a self-hosted VPS
# behind nginx may pick another (the VPS runbook uses 3003).
PORT=3000

# ─── Admin (stopgap auth) ────────────────────────────────────────────────────
# Shared secret gating the tenant admin area (e.g. /u/{slug}/admin/rooms) and
# every admin mutation. Set it to enable admin; leave it unset to disable admin
# entirely (fail closed). It is exchanged for a per-tenant, HttpOnly, signed
# cookie at /admin/login. STOPGAP until the identity module. Never commit it.
ADMIN_SECRET=

# ─── LGU timetable adapter ───────────────────────────────────────────────────
# fixture = replay recorded responses from tests/fixtures (default; used in CI).
# live    = fetch from the real portal (never run in CI). The old public dev API
#           is permanently dead; the source is now the portal itself.
SOURCE_MODE=fixture

# Base URL of the LGU timetable portal.
LGU_BASE_URL=https://timetable.lgu.edu.pk

# Optional session override. The adapter mints its OWN anonymous session
# (autonomous, no login), so this is normally left empty. Set it only to reuse a
# specific browser session. Secret; never commit it.
LGU_PHPSESSID=

# Max concurrent in-flight requests during ingestion (politeness budget).
LGU_CONCURRENCY=4

# Optional politeness caps for the full crawl (unset = full every semester,
# degree, and section). Handy for a bounded recording run.
LGU_MAX_SEMESTERS=
LGU_MAX_DEGREES=
LGU_MAX_SECTIONS=
