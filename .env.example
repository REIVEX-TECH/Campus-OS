# Copy to .env and fill in. .env is git-ignored. Never commit real secrets.
#
# RUNTIME FORWARDING: the running web process only receives the vars listed in
# apps/web/lib/app-env.vars.json (the single source of truth). On the self-hosted
# VPS, ecosystem.config.cjs forwards exactly that set, and the app asserts it at
# boot (apps/web/instrumentation.ts): a var declared there that is missing
# (required) or set in .env but not reaching the process crashes the boot with a
# clear message instead of degrading silently. Owner-only creds
# (MIGRATION_DATABASE_URL) and build-time vars (NEXT_PUBLIC_FIREBASE_*) are
# deliberately NOT forwarded. To add a runtime var: edit the manifest, then
# restart with `pm2 restart ecosystem.config.cjs --update-env` so the ecosystem
# re-reads .env (restarting by app name does not re-read this config).

# ─── Database ────────────────────────────────────────────────────────────────
# Single connection string used by BOTH migrations and app runtime (see
# CLAUDE.md §4 "single DATABASE_URL"). It points at the least-privilege,
# NOSUPERUSER role `campusos_app` created by scripts/db-bootstrap.sql. Row-Level
# Security is FORCED on every tenant-scoped table, so this role — even as the
# table owner — cannot read across tenants.
DATABASE_URL=postgres://campusos_app:campusos_dev_password@localhost:5432/campusos_dev

# Separate database used only by the integration test suite (it is reset by the
# tests). Same least-privilege role.
# Migrations run as the SCHEMA OWNER, not the runtime role. The application
# connects as a role that owns nothing, so row-level security always applies to
# it and it holds no DDL and no TRUNCATE (TRUNCATE ignores RLS, so a runtime role
# able to run it could empty every tenant at once). Falls back to DATABASE_URL if
# unset, for a database that has not been split yet.
#
# DATABASE_URL is the one var REQUIRED at runtime: the app refuses to boot
# without it. MIGRATION_DATABASE_URL and the TEST_* vars below are owner/test
# connections and are never forwarded to the running app.
MIGRATION_DATABASE_URL=postgres://campusos_owner:campusos_dev_password@localhost:5432/campusos_dev
TEST_MIGRATION_DATABASE_URL=postgres://campusos_owner:campusos_dev_password@localhost:5432/campusos_test

TEST_DATABASE_URL=postgres://campusos_app:campusos_dev_password@localhost:5432/campusos_test

# ─── Web / tenancy ───────────────────────────────────────────────────────────
# Three host vars work together. In production PLATFORM_HOST and
# TENANT_BASE_DOMAIN are the SAME value (campusos.reivex.io): tenants nest UNDER
# the platform root as subdomains of it. APP_DOMAIN is the LEGACY flat root kept
# only for a removable redirect. The /u/{slug} path prefix is the local-dev
# fallback. See docs/DEPLOY.md (Vercel/Neon) or docs/DEPLOY-VPS.md (self-hosted).

# TENANT_BASE_DOMAIN — the base domain tenant subdomains nest under: a tenant is
# {slug}.TENANT_BASE_DOMAIN. In production set it to campusos.reivex.io so
# lgu.campusos.reivex.io resolves to the `lgu` tenant. Until it is set,
# resolution falls back to APP_DOMAIN, so the app is unchanged (the migration is
# inert until you configure this).
TENANT_BASE_DOMAIN=localhost:3000

# PLATFORM_HOST — the platform landing host that is NOT a tenant (it lists the
# universities). In production this equals TENANT_BASE_DOMAIN (campusos.reivex.io):
# the bare base serves the landing, its subdomains are tenants. Leave empty in
# local dev (the bare localhost host already serves the landing).
# PLATFORM_HOST also sets the absolute origin that social cards resolve against
# (metadataBase). Statically rendered routes have no request host to read, so
# leaving it unset makes shared-link previews point at localhost.
PLATFORM_HOST=

# APP_DOMAIN — LEGACY root domain (e.g. reivex.io). Kept ONLY so requests on the
# old flat form {slug}.APP_DOMAIN (lgu.reivex.io) 308-redirect to the nested form
# {slug}.TENANT_BASE_DOMAIN. Removable: unset it (or set it equal to
# TENANT_BASE_DOMAIN) to drop the legacy redirect. If TENANT_BASE_DOMAIN is unset
# this is still the active tenant-resolution root (the pre-migration behaviour).
APP_DOMAIN=localhost:3000

# Port the Next.js server listens on. Dev defaults to 3000; a self-hosted VPS
# behind nginx may pick another (the VPS runbook uses 3003).
PORT=3000

# ─── SEO ─────────────────────────────────────────────────────────────────────
# Optional Google Search Console verification token. When set, it renders the
# <meta name="google-site-verification"> tag on every page (the HTML-tag
# verification method). Leave empty to omit the tag. See docs/SEO.md for the
# full setup. Not a secret, but it is deployment-specific, so it is not
# committed. Prefer the DNS verification method, which needs no token here.
GOOGLE_SITE_VERIFICATION=

# ─── Admin ───────────────────────────────────────────────────────────────────
# There is no admin secret. Admin is a role on an account: a Google sign in with
# an address listed in the tenant's `adminEmails` (tenants/<slug>/tenant.config.ts)
# holds tenant_admin, and nothing in the environment opens the admin area. The
# session cookie is an opaque token stored hashed; nothing is signed.

# SUPERADMIN_EMAILS — who MAY become a platform administrator (the platform
# host's /admin: creating and editing universities). A Google sign in with a
# listed address writes a platform_roles row once; the row, not this list, is
# what every request checks afterwards. Comma separated. Leave empty to have no
# platform admin. Removing an address here does not remove the row. This is a
# runtime var (in the manifest): if you set it in .env but it does not reach the
# process, the app now crashes at boot rather than silently having no platform
# admin. See docs/runbooks/platform-admin-credentials.md.
SUPERADMIN_EMAILS=

# ─── LGU timetable adapter ───────────────────────────────────────────────────
# fixture = replay recorded responses from tests/fixtures (default; used in CI).
# live    = fetch from the real portal (never run in CI). The old public dev API
#           is permanently dead; the source is now the portal itself.
SOURCE_MODE=fixture

# Base URL of the LGU timetable portal.
LGU_BASE_URL=https://timetable.lgu.edu.pk

# Optional session override. The adapter mints its OWN anonymous session
# (autonomous, no login), so this is normally left empty. Set it only to reuse a
# specific browser session. Secret; never commit it.
LGU_PHPSESSID=

# Max concurrent in-flight requests during ingestion (politeness budget).
LGU_CONCURRENCY=4

# Optional politeness caps for the full crawl (unset = full every semester,
# degree, and section). Handy for a bounded recording run.
LGU_MAX_SEMESTERS=
LGU_MAX_DEGREES=
LGU_MAX_SECTIONS=

# --- Sign in (Firebase as the Google provider only) ---
# Firebase proves someone controls a Google account and nothing else: the user
# record, handle, roles and sessions all live in our Postgres. Every value here
# is PUBLIC. It identifies the project; it authorises nothing. The server
# verifies the returned token against Google's published keys, so there is no
# service account key to hold or rotate.
#
# Leave these unset and sign in simply reports that it is not configured; the
# public site is unaffected.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Server-side audience/issuer check. Defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
