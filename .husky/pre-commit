# Never commit to main (CLAUDE.md §7). The one time it happened it had to be
# unpicked by hand; this refuses it at the source. Branch first: git switch -c feat/...
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"
if [ "$branch" = "main" ]; then
  echo "" >&2
  echo "  ✖ Direct commits to main are not allowed (CLAUDE.md §7)." >&2
  echo "    Move your work onto a branch first, e.g.:" >&2
  echo "      git switch -c feat/your-change" >&2
  echo "" >&2
  exit 1
fi
pnpm exec lint-staged
